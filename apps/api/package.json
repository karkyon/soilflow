{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma": "prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:schema": "tsx scripts/gen-prisma-schema.ts",
    "db:generate": "PRISMA_SCHEMA_ENGINE_BINARY=/bin/true PRISMA_QUERY_ENGINE_LIBRARY=/dev/null prisma generate",
    "postinstall": "pnpm db:generate",
    "perf:seed": "tsx scripts/perf-seed.ts",
    "perf": "tsx scripts/perf.ts"
  },
  "dependencies": {
    "@google-cloud/kms": "^6.3.0",
    "@google-cloud/storage": "^9.0.0",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@soilflow/billing": "workspace:*",
    "@soilflow/pdf": "workspace:*",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "google-auth-library": "^11.3.4",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.11",
    "@swc/core": "^1.16.22",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
